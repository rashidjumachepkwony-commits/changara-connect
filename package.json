{
  "name": "changara-connect",
  "version": "1.1.0",
  "private": true,
  "description": "Changara Connect, with the legacy Express application retained while Cloudflare Worker and Supabase migration is completed.",
  "main": "worker/index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "wrangler dev --local --port 8787",
    "dev:legacy": "nodemon server/server.js",
    "deploy": "wrangler deploy --env production",
    "validate": "node scripts/validate-migration.js",
    "validate:worker": "wrangler deploy --dry-run --env production",
    "migrate:mongo": "node scripts/migrate-mongodb-to-supabase.js",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > supabase/types.ts",
    "legacy:start": "node server/server.js",
    "legacy:seed": "node server/seed/seed.js",
    "legacy:seed:admin": "node server/seed/seed-admin.js"
  },
  "keywords": [
    "changara",
    "cloudflare",
    "supabase",
    "marketplace",
    "directory",
    "worker"
  ],
  "author": "Changara Connect",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "wrangler": "^3.106.0"
  }
}