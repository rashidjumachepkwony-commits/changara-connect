# Local-only environment template. Never place real credentials here in a
# committed file. Production Worker secrets must be configured with Wrangler.

# Cloudflare Worker / production public configuration
FRONTEND_URL=https://startechafrica.co.ke
API_BASE_URL=https://connect-api.startechafrica.co.ke
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Local Worker development (wrangler.toml supplies non-secret defaults)
ENVIRONMENT=development

# Legacy Express app only; not used by the Cloudflare Worker.
PORT=5000
JWT_SECRET=
JWT_EXPIRES_IN=30d
MONGODB_URI=

# Optional integrations retained by the legacy application.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# Optional legacy admin bootstrap; leave unset until explicitly configured.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_NAME=