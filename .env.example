# ============================================================
# CHANGARA CONNECT - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real ".env" file to Git.
# ============================================================

# Server
PORT=5000

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/changara_connect

# JWT secret - use a long random string
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# First admin account (created by `npm run seed` or `npm run seed:admin`)
ADMIN_EMAIL=admin@changaraconnect.co.ke
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=254712345678
ADMIN_NAME=Changara Connect Admin

# ------------------------------------------------------------
# Cloudinary (optional - image hosting for production)
# Leave blank to store uploaded images locally on the server disk.
# https://cloudinary.com
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# M-PESA (Safaricom Daraja API - future / optional)
# NOT used in version 1. These are placeholders for later integration.
# ------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=

# ------------------------------------------------------------
# Client URL (used for canonical links / future push notifications)
# ------------------------------------------------------------
CLIENT_URL=http://localhost:5000